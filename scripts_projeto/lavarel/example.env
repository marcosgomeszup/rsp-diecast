# --------------------------------------------------
# RSP DIECAST / RACING COLLECTION
# Ambiente: Produção (cPanel)
# Autor: Equipe RSP Diecast
# Versão: 1.0
# Data: 2025-10-20
# --------------------------------------------------

APP_NAME="RSP Diecast"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rspdiecast.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --------------------------------------------------
# BANCO DE DADOS
# --------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=rspdiecast_dbsystem
DB_USERNAME=rspdiecast_usrmaster
DB_PASSWORD=X7OjyzhHH2

# --------------------------------------------------
# MAIL CONFIG
# (opcional — pode ativar futuramente)
# --------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.rspdiecast.com.br
MAIL_PORT=587
MAIL_USERNAME=contato@rspdiecast.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contato@rspdiecast.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------
# AUTENTICAÇÃO SOCIAL (GOOGLE)
# --------------------------------------------------
GOOGLE_CLIENT_ID=SEU_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET_GOOGLE
GOOGLE_REDIRECT_URI=https://rspdiecast.com.br/auth/google/callback

# --------------------------------------------------
# SISTEMA DE ARQUIVOS (UPLOAD)
# --------------------------------------------------
FILESYSTEM_DISK=public
FILESYSTEM_DRIVER=local
FILESYSTEM_VISIBILITY=public

# --------------------------------------------------
# PWA E FRONTEND
# --------------------------------------------------
PWA_ENABLED=true
PWA_MANIFEST_NAME="RSP Diecast"
PWA_THEME_COLOR="#00205B"
PWA_BACKGROUND_COLOR="#00205B"
PWA_DISPLAY="standalone"
PWA_ORIENTATION="portrait"
PWA_ICON_PATH="public/icons/icon-512x512.png"

# --------------------------------------------------
# EXPORTAÇÃO DE RELATÓRIOS
# --------------------------------------------------
EXPORT_DEFAULT_FORMAT=xlsx
EXPORT_STORAGE_PATH=storage/app/exports

# --------------------------------------------------
# CACHE E FILAS
# --------------------------------------------------
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --------------------------------------------------
# CONFIGURAÇÕES ADICIONAIS
# --------------------------------------------------
BROADCAST_DRIVER=log
FILESYSTEM_CLOUD=s3
